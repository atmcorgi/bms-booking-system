# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/bms_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_database_password

# SePay Configuration
# Lấy từ SePay dashboard
SEPAY_BANK_ACC=your_bank_account
SEPAY_BANK_NAME=your_bank_name
SEPAY_API_KEY=your_sepay_api_key
SEPAY_MERCHANT_ID=your_merchant_id
SEPAY_SECRET_KEY=your_secret_key

# Security
# Tạo một secret key mạnh cho JWT (ít nhất 32 ký tự)
SECURITY_JWT_SECRET=your_strong_jwt_secret_key

# Cloudinary Configuration
# Lấy từ Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend Configuration
VITE_API_BASE_URL=http://backend:8080
FRONTEND_BASE_URL=http://localhost:5173

# Mail (Gmail SMTP)
MAIL_USERNAME=your_gmail_address
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=your_gmail_address
MAIL_FROM_NAME="MyCinema Support"

# Other
NGROK_AUTHTOKEN=your_ngrok_authtoken
