# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/bms_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_database_password

# VNPAY Configuration
# Lấy từ VNPAY merchant portal: https://sandbox.vnpayment.vn/merchantv2/
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/vnpay/return
VNPAY_IPN_URL=http://localhost:8080/vnpay/ipn

# Security
# Tạo một secret key mạnh cho JWT (ít nhất 32 ký tự)
SECURITY_JWT_SECRET=your_strong_jwt_secret_key

# Cloudinary Configuration
# Lấy từ Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Configuration
VITE_API_BASE_URL=http://backend:8080
