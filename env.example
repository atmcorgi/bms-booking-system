# Database Configuration
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_DATABASE=bms_db
MYSQL_USER=bms_user
MYSQL_PASSWORD=your_secure_password

# Docker Registry
DOCKER_REGISTRY=ghcr.io/your-username/your-repo
VERSION=latest

# Security
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here

# VNPay Configuration (Production)
VNPAY_TMNCODE=your_vnpay_tmncode
VNPAY_HASHSECRET=your_vnpay_hash_secret
VNPAY_PAYURL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURNURL=https://yourdomain.com/vnpay/return
VNPAY_IPNURL=https://yourdomain.com/vnpay/ipn

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Server Configuration
HOST=your_server_ip_or_domain
USERNAME=your_ssh_username
SSH_KEY=your_ssh_private_key

# SSL Configuration (Optional)
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/private.key
